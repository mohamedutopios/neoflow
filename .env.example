# Copier en .env (jamais versionné) puis adapter si besoin : cp .env.example .env
# Base PostgreSQL du profil dev (docker compose et backend)
DB_USER=neoflow
DB_PASSWORD=neoflow
# Port publié sur le poste (à changer si un PostgreSQL local occupe déjà 5432)
POSTGRES_PORT=5432

# Modèle d'embeddings téléchargé par le service ollama-modeles (profil ia)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Clé API Anthropic personnelle (OpenCode et laboratoires). Ne jamais la committer ni la partager.
# Préférer l'export dans le shell ou `opencode auth login` à ce fichier.
ANTHROPIC_API_KEY=
