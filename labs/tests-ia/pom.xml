<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.neosoft.neoflow</groupId>
    <artifactId>tests-ia</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>tests-ia</name>
    <description>Lab J07 : générateur de tests vérifié et assistant de diagnostic (SDK Java Anthropic)</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <anthropic.version>3.4.0</anthropic.version>
        <jackson.version>2.19.4</jackson.version>
        <javaparser.version>3.28.2</javaparser.version>
        <pitest.version>1.30.1</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <junit.version>5.12.2</junit.version>
        <junit-platform.version>1.12.2</junit-platform.version>
        <assertj.version>3.27.3</assertj.version>
    </properties>

    <dependencies>
        <!-- SDK Java officiel Anthropic (Messages API, sorties structurées, prompt caching) -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic.version}</version>
        </dependency>
        <!-- Lecture des logs ECS, des exports Jaeger et des réponses simulées (même version que le SDK) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- Analyse statique des tests proposés (détection des tests tautologiques) -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>${javaparser.version}</version>
        </dependency>
        <!-- Exécution des tests proposés dans une JVM fille (API du lanceur JUnit Platform) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit-platform.version}</version>
        </dependency>
        <!-- Mutation testing des tests acceptés (PIT lancé en ligne de commande dans une JVM fille) -->
        <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-command-line</artifactId>
            <version>${pitest.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5.version}</version>
        </dependency>

        <!-- Tests du lab -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- Classpath complet dans java.class.path : les JVM filles (JUnit, PIT) en ont besoin -->
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                </configuration>
            </plugin>
            <plugin>
                <!-- ./mvnw package : bibliothèques dans target/lib, lancées par le script ./tests-ia -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>bibliotheques</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
