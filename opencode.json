{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5-5",
  "small_model": "anthropic/claude-haiku-5-5",
  "share": "disabled",
  "autoupdate": false,
  "instructions": [
    "ia-toolbox/rules/*.md"
  ],
  "permission": {
    "edit": {
      "*": "ask",
      "opencode.json": "deny",
      ".opencode/plugins/*": "deny",
      ".opencode/lib/*": "deny",
      ".github/workflows/*": "deny",
      ".gitleaks.toml": "deny",
      ".semgrep/*": "deny",
      ".trivyignore*": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "secrets/*": "deny",
      "*/secrets/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny"
    },
    "shell": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch --show-current": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "rg *": "allow",
      "./mvnw -q -B test *": "allow",
      "./mvnw -B test *": "allow",
      "./mvnw test *": "allow",
      "./mvnw -q -B compile *": "allow",
      "./mvnw verify *": "allow",
      "./mvnw -q verify *": "allow",
      "./mvnw -q -B verify *": "allow",
      "npm test *": "allow",
      "npm run lint *": "allow",
      "npm run typecheck *": "allow",
      "npx vitest run *": "allow",
      "npx tsc --noEmit *": "allow",
      "bash .opencode/skills/*/scripts/*": "allow",
      "semgrep scan *": "allow",
      "gitleaks dir *": "allow",
      "gitleaks git *": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo *": "deny",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "nc *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "env": "deny",
      "printenv *": "deny",
      "*.env*": "deny"
    },
    "skill": {
      "*": "ask",
      "api-spring": "allow",
      "revue-pr": "allow"
    },
    "webfetch": "deny",
    "execute": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "ask",
    "subagent": {
      "*": "ask",
      "explore": "allow",
      "reviewer": "allow"
    },
    "opencode_worktree_create": "ask",
    "opencode_session_move": "ask"
  },
  "agent": {
    "plan": {
      "model": "anthropic/claude-opus-5-5"
    }
  }
}
